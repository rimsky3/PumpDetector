# секрети
.env
# SSH-ключі сервера (тримати поза проєктом; це — запобіжник)
*.pem
*.key
id_*

# віртуальне оточення і кеш Python
.venv/
__pycache__/
*.pyc

# налаштування редактора
.vscode/


# особисті навчальні нотатки
notes/

# згенеровані передбачення (відтворюються python train.py)
reports/*.csv

# навчені моделі (відтворюються python train.py)
models/
# стан скринера для дашборду
reports/*.json
experiments/cache/
# результати бектестів і згенеровані сторінки експериментів (відтворюються скриптами)
reports/backtests/
reports/*.html
reports/my_trades/
data/
reports/signals_stamp
# кеші експериментів (перераховуються скриптами; experiments/entry_model.py — ~25 МБ)
reports/*.pkl
# пороги монітора розбіжності бірж (spread.py): файл створює дашборд, на сервері свій
spread_config.json

# застосунок PD Watchlist (watch_app/): середовище збирання і результат
.venv-watch/
build/
dist/
watch_app/pd_watch.ico
twap_config.json
vol_config.json
.pytest_cache/
